# ============================================
# Environment Variables Template
# Copy to .env and fill in values
# ============================================

# Database
DATABASE_URL=postgresql://ecommerce:changeme@localhost:5432/ecommerce

# JWT (generate secure secrets: openssl rand -hex 64)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-in-production-use-openssl-rand-hex-64

# Server
NODE_ENV=development
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
